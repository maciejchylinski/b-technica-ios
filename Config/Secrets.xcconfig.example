// Copy to Secrets.xcconfig (same folder) and fill from Supabase Dashboard → Settings → API.
// Never commit Secrets.xcconfig.
// Note: break https:// with /$()/ so xcconfig does not treat // as a comment.
SUPABASE_URL = https:/$()/YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY = YOUR_ANON_PUBLIC_KEY
